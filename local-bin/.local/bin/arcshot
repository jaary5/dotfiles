#!/usr/bin/env python3
import os
import sys

_package_path = os.path.expanduser("~/.local/lib/arcshot")

sys.path.insert(0, _package_path)

os.environ["PYTHONPATH"] = os.pathsep.join(
    [p for p in [_package_path, os.environ.get("PYTHONPATH", "")] if p]
)

from arcshot.__main__ import main

sys.exit(main())
