# ~/.config/kitty/kitty.conf

# Remove top bar / window decorations
hide_window_decorations yes

# padding
window_padding_width 10

# Transparency
background_opacity 0.85

# Font settings
font_family Caskaydia Cove Nerd Font
font_size 11.0
bold_font auto
italic_font auto

# True color and graphics
enable_kitty_graphics yes


