
{
  "layer": "top",
  "position": "top",
  "margin": 0,
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "height": 24,
  "spacing": 4,


  "modules-left": [
  "custom/arch",
  "hyprland/workspaces",
  "hyprland/window"
  ],

  "modules-center": [
    "cpu",
    "memory",
    "temperature",
    "clock#time",
    "clock#date"
  ],

  "modules-right": [
    // "network",
    "bluetooth",
    "tray",
    "privacy",
    "hyprland/language",
    "pulseaudio",
    "pulseaudio#microphone",
    "backlight",
    "idle_inhibitor",
    "power-profiles-daemon",
    "battery",
    "custom/power"
  ],


  "custom/arch": {
  "format": "",
  "tooltip": false,
  "on-click": "walker"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": true,
    "tooltip-format-activated": "Idle inhibition ON — sleep prevented",
    "tooltip-format-deactivated": "Idle inhibition OFF — normal sleep behavior"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "tooltip": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [1, 2, 3]
    }
  },

  "hyprland/window": {
    "format": "{}",
    "tooltip": false,
    "separate-outputs": true,
    "icon": true,
    "icon-size": 14,
    "rewrite": {
      "": "  Hyprland",
      "Authenticate": "  Authenticate"
    },
    "min-length": 3,
    "max-length": 40
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 5,
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": "󰘚 {percentage}%",
    "format-critical": "󰀪 {percentage}%",
    "states": {
      "critical": 90
    },
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "kitty -e btop"
  },

  "temperature": {
    "format": " {temperatureC}°C",
    "critical-threshold": 80,
    "interval": 5,
    "tooltip": true
  },

  "clock#time": {
    "format": "󱑂 {:%H:%M}",
    "tooltip": true,
    "tooltip-format": "12-hour time: {:%I:%M %p}"
  },

  "clock#date": {
    "format": "󰨳 {:%a %d-%m}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "on-click-right": "mode",
      "format": {
        "today": "<span color='#a6e3a1'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "network": {
    "interface": "*",
    "interval": 5,
    "format": " {bandwidthUpBytes}   {bandwidthDownBytes}",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": " {ifname}\n {bandwidthUpBytes}\n {bandwidthDownBytes}",
    "tooltip-format-wifi": "󰖩 {essid} ({signalStrength}%)\n {bandwidthUpBytes}\n {bandwidthDownBytes}"
  },

  "bluetooth": {
  "format": "",
  "format-disabled": "󰂲",
  "format-off": "󰂲",
  "format-connected": " {num_connections}",
  "tooltip": true,
  "tooltip-format": "{controller_alias}\n{status}",
  "on-click": "blueman-manager",
  "on-click-right": "bluetoothctl power off"
  },
  
  "tray": {
    "icon-size": 13,
    "spacing": 8
  },

  "privacy": {
    "icon-spacing": 8,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 20
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 20
      }
    ],
    "ignore": [
      {
        "type": "audio-in",
        "name": "cava"
      }
    ]
  },

  "hyprland/language": {
    "format": "󰇧 {}",
    "format-en": "EN",
    "on-click": "hyprctl switchxkblayout current next"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip": true,
    "tooltip-format": "{desc} — {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "tooltip": true,
    "tooltip-format": "{source_desc} — {source_volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "tooltip": true,
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": true,
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱘖 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}% — {time} remaining",
    "interval": 5
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout",
    "on-click-right": "wlogout"
  }
}

