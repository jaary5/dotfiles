#!/usr/bin/env python3

import json
import urllib.parse
import urllib.request
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

TZ = ZoneInfo("Asia/Dhaka")
CITY = "Dhaka"
COUNTRY = "Bangladesh"
METHOD = 1
SCHOOL = 1

CACHE_DIR = Path.home() / ".cache" / "prayer-times"

PRAYERS = ("Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha")


def fetch_month(year, month):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache_file = CACHE_DIR / f"{year}-{month:02d}.json"

    if cache_file.exists():
        age = datetime.now().timestamp() - cache_file.stat().st_mtime
        if age < 43200:
            return json.loads(cache_file.read_text())

    params = urllib.parse.urlencode({
        "city": CITY,
        "country": COUNTRY,
        "method": METHOD,
        "school": SCHOOL,
        "timezonestring": "Asia/Dhaka",
    })

    url = (
        f"https://api.aladhan.com/v1/calendarByCity/"
        f"{year}/{month}?{params}"
    )

    request = urllib.request.Request(
        url,
        headers={"User-Agent": "prayer-times-terminal/1.0"},
    )

    with urllib.request.urlopen(request, timeout=15) as response:
        result = json.load(response)

    if result.get("code") != 200:
        raise RuntimeError("Prayer-time API returned an error.")

    cache_file.write_text(json.dumps(result["data"]))
    return result["data"]


def get_day_entry(date):
    entries = fetch_month(date.year, date.month)

    return next(
        entry for entry in entries
        if int(entry["date"]["gregorian"]["day"]) == date.day
    )


def get_prayer_datetime(date, raw_time):
    time = raw_time.split()[0]

    return datetime.strptime(time, "%H:%M").replace(
        year=date.year,
        month=date.month,
        day=date.day,
        tzinfo=TZ,
    )


def main():
    now = datetime.now(TZ)
    today = now.date()

    entry = get_day_entry(today)
    timings = entry["timings"]

    prayer_datetimes = []

    for name in PRAYERS:
        moment = get_prayer_datetime(today, timings[name])
        prayer_datetimes.append((name, moment))

    upcoming = next(
        (
            (name, moment)
            for name, moment in prayer_datetimes
            if name != "Sunrise" and moment > now
        ),
        None,
    )

    if upcoming is None:
        tomorrow = today + timedelta(days=1)
        tomorrow_entry = get_day_entry(tomorrow)

        fajr = get_prayer_datetime(
            tomorrow,
            tomorrow_entry["timings"]["Fajr"],
        )

        upcoming = ("Fajr tomorrow", fajr)

    remaining = int((upcoming[1] - now).total_seconds())
    hours, remainder = divmod(remaining, 3600)
    minutes = remainder // 60

    print()
    print("─" * 35)
    print("PRAYER TIMES TODAY".center(35))
    print("─" * 35)

    for name, moment in prayer_datetimes:
        value = moment.strftime("%I:%M %p")
        # print(f"    {name:<9} {value} ")
        print(f"{name:>10}     {value:<10}".center(35))

    print()
    print("─" * 35)
    print(f"Next: {upcoming[0]}".center(35))
    print(f"In {hours}h {minutes}m".center(35))
    print("─" * 35)
    print()
    print("Dhaka | Karachi method | Hanafi".center(35))
    print()


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"\nPrayer times unavailable: {error}")
        print("Check your internet connection.\n")
