#!/usr/bin/env python3
import configparser
import os
import re
import sys
import tempfile
from pathlib import Path

if len(sys.argv) != 2:
    print("Usage: theme-apply-dunst THEME_NAME", file=sys.stderr)
    sys.exit(2)

theme = sys.argv[1]
root = Path.home() / "dotfiles"
source = root / "themes" / theme / "dunst-colors.conf"
config = root / "dunst/.config/dunst/dunstrc"

if not source.is_file():
    print(f"Theme colors not found: {source}", file=sys.stderr)
    sys.exit(1)

colors = configparser.ConfigParser(interpolation=None)
colors.read(source)

text = config.read_text()
section = None
lines = text.splitlines(keepends=True)

for i, line in enumerate(lines):
    match = re.match(r"^\s*\[([^\]]+)\]\s*$", line)
    if match:
        section = match.group(1)
        continue

    if section not in colors:
        continue

    key_match = re.match(r"^(\s*)(foreground|background|frame_color)(\s*=\s*)(.*?)(\s*)$", line)
    if key_match:
        key = key_match.group(2)
        if key in colors[section]:
            value = colors[section][key].strip().strip('"')
            lines[i] = (
                key_match.group(1) + key + key_match.group(3)
                + '"' + value + '"' + key_match.group(5)
            )

updated = "".join(lines)
fd, temp_name = tempfile.mkstemp(
    prefix=".dunstrc.", dir=str(config.parent), text=True
)
try:
    with os.fdopen(fd, "w") as handle:
        handle.write(updated)
    os.chmod(temp_name, config.stat().st_mode)
    os.replace(temp_name, config)
except Exception:
    try:
        os.unlink(temp_name)
    except FileNotFoundError:
        pass
    raise

print(f"Dunst colors applied: {theme}")
