#!/bin/bash

# Get the current active port
CURRENT=$(pactl list sinks | awk '/alsa_output.pci-0000_30_00.6.analog-stereo/,/Active Port:/ {if($1=="Active") print $3}')

if [ "$CURRENT" = "analog-output-headphones" ]; then
    # Switch to lineout
    pactl set-sink-port alsa_output.pci-0000_30_00.6.analog-stereo analog-output-lineout
    echo "Switched to Line Out (Speakers)"
else
    # Switch to headphones
    pactl set-sink-port alsa_output.pci-0000_30_00.6.analog-stereo analog-output-headphones
    echo "Switched to Headphones"
fi
