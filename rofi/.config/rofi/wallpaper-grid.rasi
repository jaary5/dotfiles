@import "~/.config/theme-switcher/active/rofi.rasi"

configuration {
    show-icons: true;
}

window {
    width: 85%;
    height: 85%;
    border: 2px;
    border-radius: 0px;
    padding: 24px;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 10px;
    children: [ prompt, entry ];
    spacing: 12px;
}

listview {
    columns: 4;
    lines: 3;
    fixed-columns: true;
    fixed-height: true;
    spacing: 16px;
    padding: 8px;
    layout: vertical;
    flow: horizontal;
    scrollbar: true;
}

element {
    orientation: vertical;
    padding: 8px;
    spacing: 8px;
    border: 1px;
    border-radius: 0px;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 240px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    expand: true;
}

element selected {
    border: 2px;
}
