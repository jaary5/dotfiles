[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    offset = (17, 26)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color = "#585b70"
    font = "JetBrains Mono 10"
    corner_radius = 0
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    foreground = "#1e1e2e"
    background = "#a6e3a1"
    frame_color = "#a6e3a1"
    timeout = 3

[urgency_normal]
    foreground = "#cdd6f4"
    background = "#313244"
    frame_color = "#585b70"
    timeout = 5

[urgency_critical]
    foreground = "#f2cdcd"
    background = "#45475a"
    frame_color = "#f38ba8"
    timeout = 15

    