[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    offset = (17, 26)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color = "#4f5b58"
    font = "JetBrains Mono 10"
    corner_radius = 0
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    foreground = "#272e33"
    background = "#a7c080"
    frame_color = "#a7c080"
    timeout = 3

[urgency_normal]
    foreground = "#d3c6aa"
    background = "#374145"
    frame_color = "#4f5b58"
    timeout = 5

[urgency_critical]
    foreground = "#d3c6aa"
    background = "#414b50"
    frame_color = "#e67e80"
    timeout = 15

    