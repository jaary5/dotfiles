# Omarchy-inspired square-box theme for Dunst
# Catppuccin Mocha palette; no rounded notification corners.

[global]
    monitor = 0
    follow = none

    # Geometry
    width = 340
    height = (0, 150)
    origin = top-right
    offset = (12, 42)
    scale = 0
    notification_limit = 20

    # Progress bar
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 316
    progress_bar_corner_radius = 0

    # Square notification boxes
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#45475a"
    gap_size = 6
    separator_color = frame
    corner_radius = 0

    # Text
    font = "JetBrains Mono 10"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = top
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    icon_corner_radius = 0

    # History and behavior
    indicate_hidden = yes
    sort = yes
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false
    enable_pcre_regex = false

[urgency_low]
    background = "#181825"
    foreground = "#a6adc8"
    frame_color = "#45475a"
    timeout = 6
    default_icon = dialog-information

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 6
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#313244"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
