[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (0, 750)
    offset = (17, 26)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color = "#434c5e"
    font = "JetBrains Mono 10"
    corner_radius = 0
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    foreground = "#2e3440"
    background = "#a3be8c"
    frame_color = "#a3be8c"
    timeout = 3

[urgency_normal]
    foreground = "#eceff4"
    background = "#3b4252"
    frame_color = "#434c5e"
    timeout = 5

[urgency_critical]
    foreground = "#eceff4"
    background = "#434c5e"
    frame_color = "#bf616a"
    timeout = 15

    